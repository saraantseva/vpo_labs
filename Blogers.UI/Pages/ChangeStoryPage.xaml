<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Blogers.UI.Pages.ChangeStoryPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Blogers.UI.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:Blogers.UI.ValueConverters"
             Title="Редактирование истории"
             x:Name="MyPage">

    <ContentPage.Resources>
        <converters:IdToImageConverter x:Key="IdToImageConverter" />
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior 
            EventName="Loaded"
            BindingContext="{Binding BindingContext, Source={x:Reference MyPage}}"
            Command="{Binding LoadDataCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Frame Margin="0,0,0,10"
                   CornerRadius="10"
                   BackgroundColor="LightGray"
                   HorizontalOptions="Center"
                   WidthRequest="300"
                   HeightRequest="400">
                <Image Source="{Binding DisplayImage}"
                       Aspect="AspectFill"/>
            </Frame>

            <Button Text="Выбрать фото" 
                    BackgroundColor="CornflowerBlue"
                    TextColor="White"
                    Command="{Binding SelectImageCommand}"/>

            <Entry Placeholder="Описание" 
                   Text="{Binding Description}"/>

            <HorizontalStackLayout Spacing="15">
                <Entry Placeholder="Лайки" 
                       Text="{Binding LikesCount}" 
                       Keyboard="Numeric"/>
                <Entry Placeholder="Просмотры" 
                       Text="{Binding ViewsCount}" 
                       Keyboard="Numeric"/>
            </HorizontalStackLayout>

            <Picker Title="Блогер"
                    ItemsSource="{Binding Blogers}"
                    ItemDisplayBinding="{Binding Nickname}"
                    SelectedItem="{Binding SelectedBloger}" />

            <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                <Button Text="Сохранить" 
                        Command="{Binding SaveCommand}"
                        BackgroundColor="CornflowerBlue"
                        TextColor="White"/>
                <Button Text="Отмена" 
                        Command="{Binding CancelCommand}"
                        BackgroundColor="Gray"
                        TextColor="White"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>