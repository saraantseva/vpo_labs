<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Blogers.UI.Pages.StoryDetailsPage"
             Title="StoryDetailsPage"
             xmlns:converters="clr-namespace:Blogers.UI.ValueConverters">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IdToImageConverter x:Key="IdToImageConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout>
            <HorizontalStackLayout Spacing="10" 
                                   Margin="0,30,0,10"
                                   HorizontalOptions="Center">
                <Label Text="   История  " FontSize="30" FontAttributes="Bold"/>
                <Label Text="{Binding Story.Id}" FontSize="30" FontAttributes="Bold"/>
            </HorizontalStackLayout>

            <Frame Margin="20,0,20,10"
                   CornerRadius="10"
                   BackgroundColor="LightGray"
                   HorizontalOptions="Center"
                   WidthRequest="300">
                <Image Source="{Binding Story.Id, Converter={StaticResource IdToImageConverter}}"
                       Aspect="AspectFill"
                       HeightRequest="400"/>
            </Frame>


            <Button Text="Изменить фото"
                    Command="{Binding AddPhotoCommand}"
                    BackgroundColor="CornflowerBlue"
                    TextColor="White"
                    WidthRequest="150"
                    HorizontalOptions="Center"
                    Margin="0,0,0,10"/>

            <HorizontalStackLayout Spacing="10"
                                   Margin="0,0,0,20"
                                   HorizontalOptions="Center">
                <Label Text="   Description:  " FontSize="25" FontAttributes="Bold"/>
                <Label Text="{Binding Story.Description}" FontSize="25" FontAttributes="Bold"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10"
                                   Margin="0,10,0,10">
                <Label Text="   Количество лайков: " FontSize="20" FontAttributes="Bold"/>
                <Label Text="{Binding Story.LikesCount}" FontSize="20"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10"
                                   Margin="0,0,0,10">
                <Label Text="   Количество просмотров: " FontSize="20" FontAttributes="Bold"/>
                <Label Text="{Binding Story.ViewCount}" FontSize="20"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10"
                                   Margin="0,0,0,10">
                <Label Text="   история выложена: " FontSize="14"/>
                <Label Text="{Binding Story.CreationDate, StringFormat='{0:dd.MM.yyyy}'}" FontSize="14"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Редактировать" 
                     Command="{Binding ChangeStoryCommand}"
                     CommandParameter="{Binding Story}" />
        <ToolbarItem Text="Удалить" 
                     Command="{Binding DeleteStoryCommand}" 
                     Order="Primary" />
    </ContentPage.ToolbarItems>

</ContentPage>