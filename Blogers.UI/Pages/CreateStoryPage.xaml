<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Blogers.UI.Pages.CreateStoryPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Blogers.UI.ViewModels"
             x:DataType="viewmodels:CreateStoryPageViewModel"
             Title="Новая история">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Button Text="Выбрать фото" 
                    Command="{Binding SelectImageCommand}"
                    BackgroundColor="LightGray"
                    TextColor="Black"/>

            <BoxView HeightRequest="150"
                     BackgroundColor="LightGray"
                     HorizontalOptions="Fill"/>
            <Label Text="Здесь будет фото"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TranslationY="-75"
                   IsVisible="{Binding ImagePath, Converter={StaticResource StringIsEmptyConverter}}"/>

            <Entry Placeholder="Описание истории" 
                   Text="{Binding Description}" />

            <Entry Placeholder="Количество лайков" 
                   Text="{Binding LikesCount}" 
                   Keyboard="Numeric" />

            <Entry Placeholder="Количество просмотров" 
                   Text="{Binding ViewsCount}" 
                   Keyboard="Numeric" />

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="Сохранить" 
                        Command="{Binding SaveCommand}" 
                        BackgroundColor="CornflowerBlue"/>
                <Button Text="Отмена" 
                        Command="{Binding CancelCommand}" 
                        BackgroundColor="Gray"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>